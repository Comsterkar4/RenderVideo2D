# RenderVideo services
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9000
BACKEND_PUBLIC_URL=http://127.0.0.1:9000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=9001
DATABASE_URL=sqlite:///./data/render_video.db
FFMPEG_BIN=ffmpeg

# Local Ollama story analysis
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_STORY_MODEL=qwen2.5:3b

# Local ComfyUI image generation
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_DEVICE=auto
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
COMFYUI_IMAGE_TIMEOUT_SECONDS=1800

# Remote Gemini image generation. Keep the real key only in .env.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_TIMEOUT_SECONDS=300

# Optional ViViBe fallback; the Web UI can hold one key in backend RAM.
VIVIBE_API_URL=https://api.lucylab.io/json-rpc
VIVIBE_API_KEY=
VIVIBE_TIMEOUT_SECONDS=60
VIVIBE_MAX_DOWNLOAD_BYTES=104857600
